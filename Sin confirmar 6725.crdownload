// Configura tu número de teléfono con código de país (ej. 5411...)
const TELEFONO_WHATSAPP = "541130541746";

// Función para comprar productos del catálogo
function comprarProducto(nombreProducto) {
    const mensaje = encodeURIComponent(`Hola Oasis Urbano! Quisiera encargar el siguiente producto: ${nombreProducto}. ¿Cómo coordino el pago por transferencia y la entrega?`);
    window.open(`https://wa.me/${TELEFONO_WHATSAPP}?text=${mensaje}`, '_blank');
}

// Función para reservar espacio de CoWork
function reservarCoWork(tipoPlan) {
    const mensaje = encodeURIComponent(`Hola Oasis Urbano! Quisiera solicitar información/disponibilidad para el plan de CoWork: ${tipoPlan}.`);
    window.open(`https://wa.me/${TELEFONO_WHATSAPP}?text=${mensaje}`, '_blank');
}